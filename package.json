{
  "name": "farkle",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @farkle/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @farkle/server dev",
    "dev:all": "pnpm --filter @farkle/server --filter @farkle/web --parallel dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
